# Copy to terraform.tfvars and fill in the values below.

api_key             = ""  # or set NETACTUATE_API_KEY env var
billing_contract_id = ""  # your NetActuate billing contract ID

ssh_public_key  = "ssh-ed25519 AAAA... you@example.com"
location        = "SJC"
management_cidr = "203.0.113.5/32"  # restrict to your management IP in production

# ── Optional (have defaults) ──────────────────────────────────────────────────
# server_plan     = "VR1x1x25"
# server_image    = "Ubuntu 24.04 LTS (20240423)"
# bucket_capacity = 100
# wireguard_port  = 51820
# bgp_group_id    = null   # leave unset to skip legacy BGP
# secret_list_name_suffix = "run01"
