# This file is generated by terraform apply (netactuate_nke_cluster resource).
# The real kubeconfig.yaml is written to this directory at apply time — do not commit it.
# This example shows the structure for reference only.

apiVersion: v1
clusters:
  - cluster:
      certificate-authority-data: <BASE64_ENCODED_CA_CERT>
      server: https://<CLUSTER_API_IP>:<PORT>
    name: <CLUSTER_NAME>
contexts:
  - context:
      cluster: <CLUSTER_NAME>
      user: cluster-admin
    name: cluster-admin@<CLUSTER_NAME>
current-context: cluster-admin@<CLUSTER_NAME>
kind: Config
users:
  - name: cluster-admin
    user:
      token: <SERVICE_ACCOUNT_TOKEN>
